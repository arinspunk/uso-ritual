<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Uso Ritual</title>
  <meta name="description" content="{{ description || '' }}">
  <link rel="preload" href="/assets/fonts/novela-regular-webfont.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/IsaacRegular.woff2" as="font" type="font/woff2" crossorigin>
  {{ if atprotoAnchor && atprotoRkey }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/atproto-comments@1/dist/atproto-comments.css">
  {{ /if }}
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="alternate" type="application/rss+xml" title="{{ i18n.feed_title }}" href="/{{ lang }}/feed.xml">
  {{ for alt of (alternates || []) }}
    <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url }}">
  {{ /for }}
  <link rel="site.standard.publication" href="at://{{ atproto.did }}/site.standard.publication/{{ atproto.publication.rkey }}">
  {{ if atprotoRkey }}
  <link rel="site.standard.document" href="at://{{ atproto.did }}/site.standard.document/{{ atprotoRkey }}">
  {{ /if }}
</head>
<body>
  {{ include "partials/header.vto" }}
  <main class="main">
    {{ content }}
  </main>
  {{ include "partials/footer.vto" }}
</body>
</html>
