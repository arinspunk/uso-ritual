---
layout: layouts/base.vto
---
<article class="post">
  <header class="page-header">
    <h1 class="page-header__title">{{ title }}</h1>
    <time class="page-header__date" datetime="{{ date |> date('yyyy-MM-dd') }}">
      {{ date |> formatDate(lang) }}
    </time>
  </header>

  <div class="page-body">
    {{ content }}
  </div>

  {{ if atprotoAnchor && atprotoRkey }}
  <atproto-comments
    class="post-comments"
    thread-uri="at://{{ atproto.did }}/app.bsky.feed.post/{{ atprotoRkey }}"
    appview="{{ atproto.appview }}"
    lang="{{ lang }}"
  ></atproto-comments>
  <script type="module" src="https://cdn.jsdelivr.net/npm/atproto-comments@1/dist/index.js"></script>
  {{ /if }}

</article>
