---
layout: layouts/base.vto
---
<article class="post">
  <header class="post__header">
    <h1 class="post__title">{{ title }}</h1>
    <time class="post__date" datetime="{{ date |> date('yyyy-MM-dd') }}">
      {{ date |> formatDate(lang) }}
    </time>
  </header>

  <div class="post__body{{ media && media.length ? " post__body--with-media" : "" }}">
    <div class="post__content">
      {{ content }}
    </div>

    {{ if media && media.length }}
      <aside class="post__media">
        {{ for item of media }}
          {{ include "partials/media-item.vto" { item } }}
        {{ /for }}
      </aside>
    {{ /if }}
  </div>

  {{ if alternates && alternates.length > 1 }}
    <nav class="post__translations" aria-label="{{ i18n.lang_label }}">
      {{ for alt of alternates }}
        {{ if alt.lang !== lang }}
          <a href="{{ alt.url }}" lang="{{ alt.lang }}" hreflang="{{ alt.lang }}">{{ alt.lang }}</a>
        {{ /if }}
      {{ /for }}
    </nav>
  {{ /if }}
</article>
