---
layout: layouts/base.vto
---
<article class="post">
  <header class="page-header">
    <h1 class="page-header__title">{{ title }}</h1>
    <time class="page-header__date" datetime="{{ date |> date('yyyy-MM-dd') }}">
      {{ date |> formatDate(lang) }}
    </time>
  </header>

  <div class="page-body">
    {{ content }}
  </div>

  {{ if atprotoAnchor && atprotoRkey }}
  <section
    class="post-comments atproto-comments"
    data-thread-uri="at://{{ atproto.did }}/app.bsky.feed.post/{{ atprotoRkey }}"
    data-post-url="{{ atprotoRkey |> bskyPostUrl }}"
    data-appview="{{ atproto.appview }}"
  ></section>
  <script src="/assets/js/atproto-comments.js" defer></script>
  {{ /if }}

</article>
