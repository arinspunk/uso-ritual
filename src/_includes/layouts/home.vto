---
layout: layouts/base.vto
---
{{ set posts = search.pages(`lang=${lang} type=post`, "date=desc") }}

<div class="page-body">
  <div class="page-header page-header--center">
    <h1 class="page-header__title">Uso Ritual</h1>
    <p class="page-header__subtitle">Música e outros relatos</p>
  </div>

  {{ if posts.length }}
    <ol class="post-list col col--wide" reversed>
      {{ for post of posts }}
        {{ set thumbSrc = post.thumbnail || null }}
        <li class="post-list__item">
          <article class="post-card">
            {{ if thumbSrc }}
              <img
                class="post-card__thumbnail"
                src="{{ thumbSrc |> resolveImageSrc }}"
                alt=""
                loading="lazy"
              >
            {{ /if }}
            <a class="post-card__link" href="{{ post.url }}">
              <h2 class="post-card__title">{{ post.title }}</h2>
            </a>
            <time class="post-card__date" datetime="{{ post.date |> date('yyyy-MM-dd') }}">
              {{ post.date |> formatDate(lang) }}
            </time>
            {{ if post.description }}
              <p class="post-card__excerpt">{{ post.description }}</p>
            {{ /if }}
          </article>
        </li>
      {{ /for }}
    </ol>
  {{ else }}
    <p class="home__empty">—</p>
  {{ /if }}
</div>
