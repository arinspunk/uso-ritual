{{# Canonical markup for post media shortcodes.
    Helpers in media_shortcodes.ts must mirror this structure 1:1.
    kind: "image" | "embed" | "audio" | "gallery" | "quote" | "link"
    size: "wide" | "full" | "text" (default wide for media; quote uses text)
#}}

{{ if kind === "image" }}
<figure class="media col col--{{ size }}">
  <img src="{{ src }}" alt="{{ alt }}" loading="lazy">
  {{ if caption }}
  <figcaption class="media__caption">{{ caption }}</figcaption>
  {{ /if }}
</figure>
{{ /if }}

{{ if kind === "embed" }}
<figure class="media col col--{{ size }}">
  <div class="media-embed">
    <iframe src="{{ src }}" title="{{ title }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
  </div>
  {{ if caption }}
  <figcaption class="media__caption">{{ caption }}</figcaption>
  {{ /if }}
</figure>
{{ /if }}

{{ if kind === "audio" }}
<div class="media col col--wide media--audio{{ spotify ? " media--spotify" : "" }}">
  <iframe src="{{ src }}" title="{{ title }}" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
  {{ if caption }}
  <figcaption class="media__caption">{{ caption }}</figcaption>
  {{ /if }}
</div>
{{ /if }}

{{ if kind === "gallery" }}
<div class="media col col--wide post-gallery">
  {{ for item of items }}
  <figure class="post-gallery__item">
    <img src="{{ item.src }}" alt="{{ item.alt }}" loading="lazy">
    {{ if item.caption }}
    <figcaption class="media__caption">{{ item.caption }}</figcaption>
    {{ /if }}
  </figure>
  {{ /for }}
</div>
{{ /if }}

{{ if kind === "quote" }}
<blockquote class="post-quote">
  <p>{{ text }}</p>
  {{ if attribution }}
  <cite>{{ attribution }}</cite>
  {{ /if }}
</blockquote>
{{ /if }}

{{ if kind === "link" }}
<a class="media media--link" href="{{ href }}" target="_blank" rel="noopener noreferrer">{{ label }}</a>
{{ /if }}
