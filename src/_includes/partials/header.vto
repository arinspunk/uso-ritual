<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="{{ i18n.nav.home_url }}">
      Uso Ritual
    </a>

    <div class="site-header__controls">
      <div class="lang-switcher" aria-label="{{ i18n.lang_label }}">
        {{# Outros idiomas — só se existe tradução #}}
        {{ for alt of (alternates || []) }}
          {{ if alt.lang !== lang }}
            <a class="lang-switcher__item" href="{{ alt.url }}" lang="{{ alt.lang }}" hreflang="{{ alt.lang }}">{{ i18n.langs[alt.lang] || alt.lang }}</a>
          {{ /if }}
        {{ /for }}
      </div>
    </div>
  </div>
</header>
