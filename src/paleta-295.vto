          <p class="pp-combo__colors">bg #0f0720 (50%)<br>text #fff9f0 (90%)</p>
          <p class="pp-combo__ratio">~18:1</p>
          <span class="pp-combo__wcag pp-combo__wcag--aaa">AAA</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Color de acción y extra ─────────────────────────────── -->
  <section class="pp-section">
    <h2 class="pp-heading">Colores de apoyo</h2>
    <div class="pp-extras">

      <div class="pp-extra">
        <p class="pp-extra__label">Acción — Yellow</p>
        <button class="pp-action__btn" type="button">Acción de muestra</button>
        <p class="pp-extra__note">
          <span class="pp-extra__hex">#fff200</span> — Yellow<br>
          Para botones y elementos de acción.<br>
          Texto en Dull Violet Black para contraste.
        </p>
      </div>

      <div class="pp-extra">
        <p class="pp-extra__label">Extra — Blue</p>
        <div class="pp-blue-samples">
          <div class="pp-blue__swatch"></div>
          <span class="pp-blue__on-dark">Enlace sobre fondo oscuro</span>
          <div class="pp-blue__border">Cita o bloque destacado</div>
        </div>
        <p class="pp-extra__note">
          <span class="pp-extra__hex">#006eb8</span> — Blue<br>
          Acento secundario: bordes, citas,<br>
          links sobre fondo violeta oscuro.
        </p>
      </div>

    </div>
  </section>

</div>
