---
title: Paleta — Sanzo Wada Classic #295
layout: layouts/base.vto
url: /paleta-295/
---

<style>
  /* ── Layout de la herramienta ─────────────────────────────── */

  .pp {
    max-width: 860px;
    margin-inline: auto;
    padding: 2rem 1.5rem 4rem;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  .pp-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
    color: #1a1a1a;
  }

  .pp-subtitle {
    font-size: 0.8125rem;
    color: #6b6b6b;
    margin-bottom: 3rem;
  }

  .pp-section {
    margin-bottom: 3rem;
  }

  .pp-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin-bottom: 0.75rem;
  }

  /* ── Escala de swatches ───────────────────────────────────── */

  .pp-scale {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pp-swatch {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pp-swatch__color {
    width: 72px;
    height: 56px;
    border: 1px solid rgba(0,0,0,0.08);
    background-color: var(--c);
  }

  .pp-swatch__label {
    font-size: 0.625rem;
    color: #6b6b6b;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    max-width: 72px;
  }

  /* ── Combinaciones ────────────────────────────────────────── */

  .pp-combos {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pp-combo {
    display: grid;
    grid-template-columns: 1fr 200px;
    border: 1px solid rgba(0,0,0,0.08);
    overflow: hidden;
  }

  .pp-combo__preview {
    padding: 1.5rem;
    background-color: var(--bg);
    color: var(--fg);
  }

  .pp-combo__h {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 1.0625rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .pp-combo__p {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .pp-combo__caption {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.8125rem;
    margin-bottom: 0.5rem;
  }

  .pp-combo__link {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .pp-combo__meta {
    padding: 1rem 1.25rem;
    background: #f7f7f5;
    border-left: 1px solid rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
  }

  .pp-combo__name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .pp-combo__colors {
    font-size: 0.6875rem;
    color: #6b6b6b;
    font-variant-numeric: tabular-nums;
    line-height: 1.8;
  }

  .pp-combo__ratio {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .pp-combo__wcag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
    display: inline-block;
    margin-top: 0.125rem;
  }

  .pp-combo__wcag--aaa {
    background: #d1fae5;
    color: #065f46;
  }

  .pp-combo__star {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #c8102e;
  }

  /* ── Combinaciones dark ──────────────────────────────────── */

  .pp-combo--dark .pp-combo__meta {
    background: #100720;
    border-left-color: rgba(255,255,255,0.06);
  }

  .pp-combo--dark .pp-combo__name,
  .pp-combo--dark .pp-combo__ratio {
    color: #fdbf68;
  }

  .pp-combo--dark .pp-combo__colors {
    color: rgba(253,191,104,0.5);
  }

  .pp-combo--dark .pp-combo__star {
    color: #fff200;
  }

  /* ── Colores de acción y extra ────────────────────────────── */

  .pp-extras {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .pp-extra {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pp-extra__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .pp-action__btn {
    display: inline-block;
    background: #fff200;
    color: #1e0e3f;
    padding: 0.625rem 1.25rem;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    cursor: default;
    letter-spacing: 0.01em;
  }

  .pp-extra__note {
    font-size: 0.8125rem;
    color: #6b6b6b;
    line-height: 1.5;
  }

  .pp-extra__hex {
    font-weight: 600;
    color: #1a1a1a;
  }

  .pp-blue-samples {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pp-blue__swatch {
    width: 120px;
    height: 40px;
    background: #006eb8;
  }

  .pp-blue__on-dark {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    background: #1e0e3f;
    font-family: Georgia, serif;
    font-size: 0.875rem;
    color: #006eb8;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-blue__border {
    padding: 0.5rem 0.75rem;
    border-left: 3px solid #006eb8;
    font-family: Georgia, serif;
    font-size: 0.875rem;
    color: #1e0e3f;
    background: #fdbf68;
  }
</style>

